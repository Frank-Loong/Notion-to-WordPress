<?xml version="1.0"?>
<ruleset name="Notion to WordPress">
    <description>Release security gate for WordPress PHP source.</description>
    <file>includes</file>
    <file>admin</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <ini name="memory_limit" value="512M" />
    <!--
        This is intentionally a release-quality ruleset, rather than the complete
        WordPress formatting profile. The source uses PSR-4 namespaces and has
        pre-existing public APIs whose naming cannot be changed compatibly.
        Formatting is enforced independently by Prettier/PHP_CodeSniffer fixes;
        PHPStan and the test suite cover type and behavioural correctness. This
        gate covers the WordPress-specific sink and request-validation rules
        which cannot be established by those tools.
    -->
    <rule ref="WordPress.Security" />
</ruleset>
