{
  "name": "notion-to-wordpress",
  "version": "2.0.0-beta.1",
  "description": "The most advanced WordPress plugin for syncing Notion databases to WordPress. Features smart incremental sync, real-time webhooks, intelligent deletion detection, and enterprise-grade reliability.",
  "main": "notion-to-wordpress.php",
  "scripts": {
    "build": "npm run build:webpack && node scripts/build.js",
    "build:clean": "node -e \"const fs=require('fs'); if(fs.existsSync('build')) fs.rmSync('build', {recursive:true}); console.log('Build directory cleaned')\"",
    "build:reproducible": "node scripts/verify-reproducible-build.js",
    "build:verify": "node scripts/verify-build.js",
    "build:webpack": "cross-env NODE_ENV=production webpack --mode=production",
    "build:webpack:dev": "cross-env NODE_ENV=development webpack --mode=development",
    "clean": "npm run build:clean && npm run clean:dist",
    "clean:dist": "node -e \"const fs=require('fs'); if(fs.existsSync('assets/dist')) fs.rmSync('assets/dist', {recursive:true}); console.log('Dist directory cleaned')\"",
    "dev": "npm run build:webpack:dev",
    "dev:watch": "cross-env NODE_ENV=development webpack --mode=development --watch",
    "test": "npm run test:unit",
    "test:unit": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint src/**/*.{ts,js} --fix --max-warnings=0",
    "lint:check": "eslint src/**/*.{ts,js} --max-warnings=0",
    "format": "prettier --write src/**/*.{ts,js,scss,css}",
    "format:check": "prettier --check src/**/*.{ts,js,scss,css}",
    "check": "npm run format:check && npm run lint:check && npm run type-check && npm run test"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "notion",
    "sync",
    "api",
    "cms",
    "webhook",
    "incremental",
    "math",
    "mermaid",
    "katex",
    "markdown"
  ],
  "author": "Frank-Loong (https://github.com/Frank-Loong)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frank-Loong/Notion-to-WordPress.git"
  },
  "bugs": {
    "url": "https://github.com/Frank-Loong/Notion-to-WordPress/issues"
  },
  "homepage": "https://github.com/Frank-Loong/Notion-to-WordPress#readme",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.9.0"
  },
  "overrides": {
    "js-yaml": "$js-yaml"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-object-rest-spread": "^7.28.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@types/jquery": "^3.5.24",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "adm-zip": "^0.6.1",
    "archiver": "^6.0.1",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "chalk": "^4.1.2",
    "clean-webpack-plugin": "^4.0.0",
    "core-js": "^3.33.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cssnano": "^9.6.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "fs-extra": "^11.1.1",
    "glob": "^10.4.5",
    "husky": "^8.0.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "^4.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "minimist": "^1.2.8",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "prettier": "^3.0.3",
    "sass": "^1.69.0",
    "sass-loader": "^17.0.1",
    "semver": "^7.7.2",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^5.2.2",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "files": [
    "admin/",
    "assets/",
    "docs/",
    "includes/",
    "languages/",
    "wiki/",
    "notion-to-wordpress.php",
    "readme.txt",
    "uninstall.php",
    "LICENSE",
    "README.md",
    "README-zh_CN.md"
  ],
  "private": true,
  "directories": {
    "doc": "docs"
  }
}
